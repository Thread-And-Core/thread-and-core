      "Bash(nohup npm run dev -- -p 3000)",
      "Bash(disown)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:3000/)",
      "Bash(curl -s http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"/framework %{http_code}\\\\n\" http://localhost:3000/framework)",
      "Bash(curl -s -o /dev/null -w \"/styleguide %{http_code}\\\\n\" http://localhost:3000/styleguide)",
